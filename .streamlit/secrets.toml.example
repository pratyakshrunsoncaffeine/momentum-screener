# Copy these names into Streamlit Community Cloud secrets. Never commit real values.
SUPABASE_URL = "https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY = "YOUR_SUPABASE_SERVICE_ROLE_KEY"
# Fine-grained token limited to this repository with Actions: write permission.
NEWS_GITHUB_ACTIONS_TOKEN = "YOUR_FINE_GRAINED_GITHUB_TOKEN"
NEWS_GITHUB_REPOSITORY = "pratyakshrunsoncaffeine/momentum-screener"
NEWS_GITHUB_BRANCH = "main"

# Enables the protected Retrain Model control in Streamlit.
NEWS_ADMIN_PASSWORD = "CHOOSE_A_LONG_RANDOM_PASSWORD"
